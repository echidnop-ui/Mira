from __future__ import annotations

from dataclasses import dataclass, field
from enum import Enum
from typing import Mapping


class ActionKind(str, Enum):
    """
    Cognitive actions available to Heiwa.

    This enum describes WHAT Heiwa decided to do.
    It does not describe how a world executes that decision.
    """

    SPEAK = "speak"
    ASK = "ask"
    EXPLORE = "explore"
    WAIT = "wait"


@dataclass(frozen=True, slots=True)
class Observation:
    """
    Something that entered Heiwa from a world.

    Examples:
    - a human message;
    - a reply to Heiwa;
    - a world event;
    - an internal timer/tick;
    - the result of an external action.

    World-specific code may place additional information in payload,
    but cognitive modules must not depend on world implementation details.
    """

    id: str
    source: str
    kind: str
    created_at: float

    text: str | None = None
    reply_to: str | None = None

    payload: Mapping[str, object] = field(default_factory=dict)


@dataclass(frozen=True, slots=True)
class ActionIntent:
    """
    A cognitive decision made by Heiwa.

    This is an INTENTION, not proof that anything actually happened.

    Runtime/world code must later produce CompletedAction if execution
    really occurred.
    """

    id: str
    transition_id: str
    kind: ActionKind
    created_at: float

    payload: Mapping[str, object] = field(default_factory=dict)


@dataclass(frozen=True, slots=True)
class CompletedAction:
    """
    Result of attempting to execute an ActionIntent.

    Important causal distinction:

        ActionIntent != CompletedAction

    A SPEAK intention that was suppressed, rejected or failed to publish
    must not be treated as completed speech.
    """

    intent_id: str
    transition_id: str
    kind: ActionKind
    completed_at: float

    succeeded: bool

    external_id: str | None = None
    text: str | None = None

    payload: Mapping[str, object] = field(default_factory=dict)


@dataclass(frozen=True, slots=True)
class Consequence:
    """
    Something observed after a concrete transition/action.

    The transition_id is mandatory because learning must remain causal.

    A module may learn from this consequence only if it actually
    influenced the transition identified by transition_id.
    """

    id: str
    transition_id: str
    kind: str
    observed_at: float

    payload: Mapping[str, object] = field(default_factory=dict)


@dataclass(frozen=True, slots=True)
class FeedbackEvent:
    """
    Explicit human feedback tied to something concrete.

    Feedback is structured data, not a magic phrase inside normal speech.

    Examples:
    - reinforce
    - weaken
    - correction

    target_id may refer to a completed action, message or another
    explicitly addressable object.
    """

    id: str
    target_id: str
    kind: str
    created_at: float

