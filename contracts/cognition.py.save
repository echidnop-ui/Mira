from __future__ import annotations

from dataclasses import dataclass, field
from typing import Mapping


# ============================================================
# Observation
# ============================================================


@dataclass(frozen=True, slots=True)
class Observation:
    """
    Нормализованное событие, пришедшее Heiwa из какого-либо World.

    Observation не знает, как именно внешний мир получил эти данные.

    Примеры:

        Market:
            новая цена;
            изменение стакана;
            состояние портфеля;
            исполнение заявки.

        Forum:
            человеческое сообщение;
            reply;
            reaction.

        Game:
            объект появился;
            персонаж получил урон;
            изменилась позиция;
            стало доступно новое действие.

    `world` определяет источник события, например:

        "market:tbank"
        "forum:web"
        "game:minecraft"

    `kind` определяет тип события внутри World:

        "market.tick"
        "portfolio.changed"
        "message.received"
        "entity.seen"

    World-specific данные находятся только в payload.
    """

    id: str

    world: str
    kind: str

    observed_at: float

    payload: Mapping[str, object] = field(default_factory=dict)


# ============================================================
# Affordance
# ============================================================


@dataclass(frozen=True, slots=True)
class Affordance:
    """
    Конкретная возможность действия, доступная Heiwa прямо сейчас.

    Affordance != решение.

    World сообщает:

        "вот что сейчас МОЖНО сделать"

    Policy решает:

        "что из этого Я ХОЧУ сделать"

    Примеры:

        world="market:tbank"
        action="market.buy"

        world="market:tbank"
        action="market.sell"

        world="forum:web"
        action="forum.reply"

        world="game:minecraft"
        action="game.move"

        world="internal"
        action="internal.wait"

    Набор affordances динамический.

    Центральная Heiwa не должна иметь глобальный enum
    всех действий всех будущих Worlds.
    """

    id: str

    world: str
    action: str

    offered_at: float

    # Данные, описывающие конкретную возможность.
    #
    # Например для рынка:
    #
    # {
    #     "instrument_id": "...",
    #     "side": "buy",
    #     "min_quantity": 1,
    #     "max_quantity": 10,
    # }
    #
    # Для игры:
    #
    # {
    #     "target_id": "door_14",
    #     "distance": 2.4,
    # }
    payload: Mapping[str, object] = field(default_factory=dict)

    # Ограничения исполнения.
    #
    # Это технические ограничения World,
    # а не cognitive decision.
    constraints: Mapping[str, object] = field(default_factory=dict)

    # Некоторые возможности могут исчезать.
    expires_at: float | None = None


# ============================================================
# ActionIntent
# ============================================================


@dataclass(frozen=True, slots=True)
class ActionIntent:
    """
    Cognitive decision Heiwa.

    Heiwa выбрала конкретный Affordance
    в рамках конкретного causal transition.

    ВАЖНО:

        ActionIntent != ActionAttempt
        ActionIntent != CompletedAction

    Желание купить акцию ещё не означает,
    что заявка была отправлена.

    Желание сказать фразу ещё не означает,
    что сообщение было опубликовано.
    """

    id: str

    transition_id: str

    affordance_id: str

    world: str
    action: str

    created_at: float

    # Конкретизация выбранного affordance.
    #
    # Например:
    #
    # market.buy:
    # {
    #     "quantity": 1,
    #     "price": 312.40,
    # }
    #
    # game.move:
    # {
    #     "x": 4,
    #     "y": 7,
    # }
    parameters: Mapping[str, object] = field(default_factory=dict)


# ============================================================
# ActionAttempt
# ============================================================


@dataclass(frozen=True, slots=True)
class ActionAttempt:
    """
    World действительно попытался выполнить ActionIntent.

    Этот уровень нужен отдельно от Intent.

    Особенно это важно для внешних сред.

    Например T-Bank:

        Heiwa решила BUY
            ↓
        ActionIntent

        Runtime отправил API request
            ↓
        ActionAttempt

        Биржа реально исполнила / отклонила / отменила
            ↓
        CompletedAction

    `accepted` означает только то,
    что среда приняла попытку к обработке.

    Это ещё не означает успешный конечный результат.
    """

    id: str

    intent_id: str
    transition_id: str

    world: str
    action: str

    attempted_at: float

    accepted: bool

    # Например order_id от брокера,
    # message_id форума,
    # action handle игрового движка.
    external_id: str | None = None

    payload: Mapping[str, object] = field(default_factory=dict)


# ============================================================
# CompletedAction
# ============================================================


@dataclass(frozen=True, slots=True)
class CompletedAction:
    """
    Фактический итог выполнения действия.

    Это первый объект, который имеет право утверждать:

        "действие реально завершилось"

    Для разных Worlds завершение означает разное.

    Market:
        order filled / rejected / cancelled

    Forum:
        сообщение реально опубликовано

    Game:
        движение/строительство/атака реально выполнены

    `status` должен быть world-independent по смыслу,
    но конкретные дополнительные данные можно хранить в payload.

    Примеры status:

        "succeeded"
        "failed"
        "rejected"
        "cancelled"
        "partial"
    """

    id: str

    attempt_id: str
    intent_id: str
    transition_id: str

    world: str
    action: str

    completed_at: float

    status: str
    succeeded: bool

    external_id: str | None = None

    payload: Mapping[str, object] = field(default_factory=dict)


# ============================================================
# Consequence
# ============================================================


@dataclass(frozen=True, slots=True)
class Consequence:
    """
    Последствие causal transition.

    Последствие может появиться значительно позже Action.

    Пример рынка:

        transition 42
        → BUY
        → order filled
        → прошло время
        → цена изменилась
        → portfolio value изменился
        → Consequence(transition_id="42")

    Именно transition_id связывает delayed learning
    с тем состоянием cognition, которое реально породило действие.

    Важно:

    Consequence НЕ является автоматически rewar
    Это наблюдаемый результат.

    Predictor / Value / Learning сами решают,
    какую обучающую информацию из него извлекать.
    """

    id: str

    transition_id: str

    world: str
    kind: str

    observed_at: float

    # Если consequence относится к конкретному
    # реально завершённому действию.
    completed_action_id: str | None = None

    payload: Mapping[str, object] = field(default_factory=dict)


# ============================================================
# FeedbackEvent
# ============================================================


@dataclass(frozen=True, slots=True)
class FeedbackEvent:
    """
    Явный структурированный feedback.

    Он не должен маскироваться под обычный текст.

    Возможные виды:

        reinforce
        weaken
        correction
        preference
        demonstration

    `target_id` указывает на конкретный объект,
    к которому относится feedback.

    Например:

        CompletedAction
        message
        transition
        utterance

    Runtime или Learning module позже разрешит target_id
    в конкретный causal объект.
    """

    id: str

    target_id: str

    kind: str

    created_at: float

    payload: Mapping[str, object] = field(default_factory=dict)
